# Copy this file to .env.local and adjust as needed.

# Server-side base URL used by Server Components and route handlers to
# reach the backend directly (e.g. the docker-compose service name). Node
# runs on the server so this never reaches the browser.
API_URL=http://backend:8080

# Client-side base URL used by code that runs in the browser. Leave empty
# in production: requests go to the same origin and are proxied to the
# backend by Caddy (see ../../caddy/Caddyfile). Override for local dev when
# running the backend without Caddy in front, e.g.:
# NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=
